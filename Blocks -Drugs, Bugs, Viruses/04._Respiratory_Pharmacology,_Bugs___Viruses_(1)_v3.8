function ensureAudioContext() {
  if (!isSoundEnabled) return null;
  if (!audioCtx && (window.AudioContext || window.webkitAudioContext)) {
    const Ctor = window.AudioContext || window.webkitAudioContext;
    audioCtx = new Ctor();
  }
  if (audioCtx && audioCtx.state === 'suspended') {
    audioCtx.resume().catch(() => {});
  }
  return audioCtx;
}

function playSfx(type) {
  if (!isSoundEnabled || !isSfxEnabled) return;
  try {
    const ctx = ensureAudioContext();
    if (!ctx) return;
    const now = ctx.currentTime;
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    osc.connect(gain);
    gain.connect(ctx.destination);
    if (type === 'steer') {
      osc.type = 'triangle';
      osc.frequency.setValueAtTime(340, now);
      osc.frequency.exponentialRampToValueAtTime(520, now + 0.07);
      gain.gain.setValueAtTime(0.08, now);
      gain.gain.exponentialRampToValueAtTime(0.001, now + 0.08);
      osc.start(now);
      osc.stop(now + 0.08);
    } else if (type === 'correct') {
      osc.type = 'sine';
      osc.frequency.setValueAtTime(523.25, now);
      osc.frequency.setValueAtTime(659.25, now + 0.07);
      osc.frequency.setValueAtTime(783.99, now + 0.14);
      gain.gain.setValueAtTime(0.13, now);
      gain.gain.exponentialRampToValueAtTime(0.001, now + 0.28);
      osc.start(now);
      osc.stop(now + 0.28);
    } else if (type === 'heal') {
      osc.type = 'sine';
      osc.frequency.setValueAtTime(440, now);
      osc.frequency.exponentialRampToValueAtTime(880, now + 0.22);
      gain.gain.setValueAtTime(0.13, now);
      gain.gain.exponentialRampToValueAtTime(0.001, now + 0.25);
      osc.start(now);
      osc.stop(now + 0.25);
    } else if (type === 'wrong') {
      osc.type = 'sawtooth';
      osc.frequency.setValueAtTime(175, now);
      osc.frequency.exponentialRampToValueAtTime(75, now + 0.26);
      gain.gain.setValueAtTime(0.12, now);
      gain.gain.exponentialRampToValueAtTime(0.001, now + 0.27);
      osc.start(now);
      osc.stop(now + 0.27);
    } else if (type === 'warp') {
      osc.type = 'sine';
      osc.frequency.setValueAtTime(260, now);
      osc.frequency.exponentialRampToValueAtTime(680, now + 0.15);
      gain.gain.setValueAtTime(0.06, now);
      gain.gain.exponentialRampToValueAtTime(0.001, now + 0.16);
      osc.start(now);
      osc.stop(now + 0.16);
    }
  } catch (e) {}
}

function triggerHauntedPianoNote(ctx, dest, freq) {
  const now = ctx.currentTime;
  const osc1 = ctx.createOscillator();
  const osc2 = ctx.createOscillator();
  const env = ctx.createGain();
  const filter = ctx.createBiquadFilter();
  osc1.type = 'triangle';
  osc2.type = 'sine';
  osc1.frequency.setValueAtTime(freq, now);
  osc2.frequency.setValueAtTime(freq * 2.003, now);
  filter.type = 'lowpass';
  filter.frequency.setValueAtTime(1200, now);
  filter.frequency.exponentialRampToValueAtTime(340, now + 1.4);
  env.gain.setValueAtTime(0.0001, now);
  env.gain.linearRampToValueAtTime(0.14, now + 0.025);
  env.gain.exponentialRampToValueAtTime(0.0001, now + 1.65);
  osc1.connect(filter);
  osc2.connect(filter);
  filter.connect(env);
  env.connect(dest);
  osc1.start(now);
  osc2.start(now);
  osc1.stop(now + 1.7);
  osc2.stop(now + 1.7);
}

function startProceduralZombiesBgm() {
  stopProceduralZombiesBgm();
  if (!isSoundEnabled) return;
  const ctx = ensureAudioContext();
  if (!ctx) return;
  const master = ctx.createGain();
  master.gain.setValueAtTime(bgmVolume * 0.45, ctx.currentTime);
  master.connect(ctx.destination);
  bgmNodes.masterGain = master;

  const droneFilter = ctx.createBiquadFilter();
  droneFilter.type = 'lowpass';
  droneFilter.frequency.setValueAtTime(165, ctx.currentTime);
  droneFilter.Q.setValueAtTime(2.5, ctx.currentTime);
  const droneGain = ctx.createGain();
  droneGain.gain.setValueAtTime(0.18, ctx.currentTime);
  const d1 = ctx.createOscillator();
  const d2 = ctx.createOscillator();
  d1.type = 'sawtooth';
  d2.type = 'sawtooth';
  d1.frequency.setValueAtTime(55.0, ctx.currentTime);
  d2.frequency.setValueAtTime(55.45, ctx.currentTime);
  const lfo = ctx.createOscillator();
  const lfoGain = ctx.createGain();
  lfo.type = 'sine';
  lfo.frequency.setValueAtTime(0.14, ctx.currentTime);
  lfoGain.gain.setValueAtTime(48, ctx.currentTime);
  lfo.connect(lfoGain);
  lfoGain.connect(droneFilter.frequency);
  d1.connect(droneFilter);
  d2.connect(droneFilter);
  droneFilter.connect(droneGain);
  droneGain.connect(master);
  d1.start();
  d2.start();
  lfo.start();
  bgmNodes.droneOsc1 = d1;
  bgmNodes.droneOsc2 = d2;
  bgmNodes.lfoOsc = lfo;

  const bufSize = ctx.sampleRate * 2;
  const noiseBuf = ctx.createBuffer(1, bufSize, ctx.sampleRate);
  const data = noiseBuf.getChannelData(0);
  for (let i = 0; i < bufSize; i++) data[i] = (Math.random() * 2 - 1) * 0.35;
  const noise = ctx.createBufferSource();
  noise.buffer = noiseBuf;
  noise.loop = true;
  const noiseFilter = ctx.createBiquadFilter();
  noiseFilter.type = 'bandpass';
  noiseFilter.frequency.setValueAtTime(950, ctx.currentTime);
  noiseFilter.Q.setValueAtTime(1.4, ctx.currentTime);
  const noiseGain = ctx.createGain();
  noiseGain.gain.setValueAtTime(0.025, ctx.currentTime);
  noise.connect(noiseFilter);
  noiseFilter.connect(noiseGain);
  noiseGain.connect(master);
  noise.start();
  bgmNodes.noiseSource = noise;

  const hauntedPattern = [
    440.00, 523.25, 493.88, 392.00,
    440.00, 329.63, 349.23, 329.63,
    440.00, 523.25, 587.33, 523.25,
    493.88, 392.00, 329.63, 0
  ];
  bgmNodes.stepIndex = 0;
  const stepNote = () => {
    if (!isSoundEnabled || !isBgmPlaying || !bgmNodes.masterGain) return;
    const freq = hauntedPattern[bgmNodes.stepIndex % hauntedPattern.length];
    bgmNodes.stepIndex++;
    if (freq > 0) triggerHauntedPianoNote(ctx, bgmNodes.masterGain, freq);
  };
  stepNote();
  bgmNodes.noteIntervalId = setInterval(stepNote, 620);
}

function stopProceduralZombiesBgm() {
  if (bgmNodes.noteIntervalId) {
    clearInterval(bgmNodes.noteIntervalId);
    bgmNodes.noteIntervalId = null;
  }
  ['droneOsc1', 'droneOsc2', 'lfoOsc', 'noiseSource'].forEach((k) => {
    if (bgmNodes[k]) {
      try { bgmNodes[k].stop(); } catch (e) {}
      try { bgmNodes[k].disconnect(); } catch (e) {}
      bgmNodes[k] = null;
    }
  });
  if (bgmNodes.masterGain) {
    try { bgmNodes.masterGain.disconnect(); } catch (e) {}
    bgmNodes.masterGain = null;
  }
}

function syncSoundControlsUI() {
  const masterBtn = document.getElementById('master-sound-btn');
  const sfxBtn = document.getElementById('audio-toggle-btn');
  const menuBgmBtn = document.getElementById('menu-bgm-btn');
  const volLabel = document.getElementById('bgm-vol-label');
