  resetRunState();
  buildSkillTree();
  persistAppState();
}

function restartOrdered() {
  closeAllModals();
  if (isMenuOpen) toggleMenuDrawer();
  buildDeck(false);
  resetRunState();
}

function restartRandomized() {
  closeAllModals();
  if (isMenuOpen) toggleMenuDrawer();
  buildDeck(true);
  resetRunState();
}

function retryMissedOnly() {
  if (!missedQuestions.length) return;
  const copy = missedQuestions.slice();
  closeAllModals();
  buildDeck(true, copy);
  resetRunState();
}

function handleResetMastery(btn) {
  if (!btn) return;
  if (btn.dataset.armed !== 'true') {
    btn.dataset.armed = 'true';
    btn.textContent = `⚠ Confirm Reset?`;
    setTimeout(() => {
      if (btn.dataset.armed === 'true') {
        btn.dataset.armed = 'false';
        btn.textContent = `⚠ Reset Mastery`;
      }
    }, 3200);
    return;
  }
  btn.dataset.armed = 'false';
  btn.textContent = `⚠ Reset Mastery`;
  masteredIds = [];
  missedQuestions = [];
  bestXp = 0;
  bestStreak = 0;
  phaseFilter = 'all';
  ['sector-filter', 'compartment-filter', 'age-filter', 'behavior-filter', 'angle-filter'].forEach((id) => {
    const el = document.getElementById(id);
    if (el) el.value = 'all';
  });
  document.querySelectorAll('.phase-mix-pill[data-phase]').forEach((p) => {
    p.classList.toggle('is-selected', p.dataset.phase === 'all');
  });
  syncMissedOptionLabel();
  buildDeck(false);
  resetRunState();
  buildSkillTree();
  persistAppState();
}

function resetRunState() {
  currentIndex = 0;
  playerHp = GAME_CONFIG.maxHp;
  playerXp = 0;
  streak = 0;
  correctCount = 0;
  answeredCount = 0;
  healCheckpointCounter = 0;
  if (document.getElementById('sector-filter')?.value !== 'missed') {
    missedQuestions = [];
  }
  isRunFinished = false;
  isModalOpen = false;
  syncMissedOptionLabel();
  prepareNextGate();
  updateTelemetryUI();
}

function prepareNextGate() {
  currentLane = 1;
  hasChosenLane = false;
  craftVisualLane = 1;
  gateDistance = GAME_CONFIG.gateStartDistance;
  isStoppedAtGate = false;
  warpSurgeTimer = 0.45;
  portalFlareLane = -1;
  portalFlareTimer = 0;
  for (let i = 0; i < 3; i++) {
    document.getElementById(`lane-${i}-card`)?.classList.remove('is-fused', 'is-selected');
  }
  updateQuestionStageUI();
  updateTelemetryUI();
  startQuestionTimer();
  playSfx('warp');
}

function triggerVignette(type) {
  const vig = document.getElementById('vignette-overlay');
  const shell = document.getElementById('viewport-shell');
  if (vig) {
    vig.classList.remove('is-damage', 'is-heal');
    void vig.offsetWidth;
    vig.classList.add(type === 'damage' ? 'is-damage' : 'is-heal');
    setTimeout(() => vig.classList.remove('is-damage', 'is-heal'), 420);
  }
  if (type === 'damage' && shell) {
    shell.classList.remove('shake-anim');
    void shell.offsetWidth;
    shell.classList.add('shake-anim');
  }
}

function showHealToast(amount) {
  const toast = document.getElementById('heal-toast');
  if (!toast) return;
  toast.textContent = `✚ STREAK BONUS +${amount} HP`;
  toast.classList.add('is-visible');
  setTimeout(() => toast.classList.remove('is-visible'), 2000);
}

function selectLaneAndResolve(laneIndex) {
  if (isModalOpen || isMenuOpen || isRunFinished) return;
  if (laneIndex < 0 || laneIndex > 2) return;
  currentLane = laneIndex;
  hasChosenLane = true;
  portalFlareLane = laneIndex;
  portalFlareTimer = 0.35;
  updateLaneHighlight();
  playSfx('steer');
  resolveGateChoice(laneIndex);
}

function resolveGateChoice(chosenLane) {
  if (timerIntervalId) clearInterval(timerIntervalId);
  isModalOpen = true;
  const q = getCurrentQuestion();
  const isTimesUp = chosenLane === -1;
  const isCorrect = !isTimesUp && chosenLane === q.correctIndex;
  answeredCount++;

  let xpDelta = 0;
  let hpDeltaLabel = '';

  if (isCorrect) {
    correctCount++;
    streak++;
    if (streak > bestStreak) bestStreak = streak;
    if (!masteredIds.includes(q.id)) masteredIds.push(q.id);
    const prevHp = playerHp;
    playerHp = Math.min(GAME_CONFIG.maxHp, playerHp + GAME_CONFIG.hpReward);
    const smallGain = playerHp - prevHp;
    hpDeltaLabel = smallGain > 0 ? `+${smallGain} HP` : `MAX HP`;
    xpDelta = Math.round(100 * getComboMultiplier());
    playerXp += xpDelta;
    if (playerXp > bestXp) bestXp = playerXp;
    healCheckpointCounter++;
    playSfx('correct');
    if (healCheckpointCounter >= GAME_CONFIG.healStreakStep) {
      healCheckpointCounter = 0;
      const beforeHeal = playerHp;
      playerHp = Math.min(GAME_CONFIG.maxHp, playerHp + GAME_CONFIG.healAmount);
      const gained = playerHp - beforeHeal;
      hpDeltaLabel = gained > 0 ? `+${gained} HP` : `MAX HP`;
      triggerVignette('heal');
      showHealToast(gained > 0 ? gained : GAME_CONFIG.healAmount);
      playSfx('heal');
    }
  } else {
    streak = 0;
    healCheckpointCounter = 0;
    playerHp = Math.max(0, playerHp - GAME_CONFIG.hpPenalty);
    hpDeltaLabel = `-${GAME_CONFIG.hpPenalty} HP`;
    if (!missedQuestions.some((item) => item.id === q.id)) missedQuestions.push(q);
    syncMissedOptionLabel();
    triggerVignette('damage');
    playSfx('wrong');
  }

  updateTelemetryUI();
  populateOutcomeModal(q, chosenLane, isCorrect, xpDelta, hpDeltaLabel, isTimesUp);
  persistAppState();
}

function renderDossierBullets(el, lines) {
  if (!el) return;
  const items = (Array.isArray(lines) ? lines : [lines])
    .flatMap((line) => String(line || '').split(/\n|<br\s*\/?>/i))
    .map((line) => line.replace(/^\s*[•\-\*]\s*/, '').trim())
    .filter(Boolean);
  el.innerHTML = items.map((line) => `<p class="dossier-line">• ${line}</p>`).join('');
}

function populateOutcomeModal(q, chosenLane, isCorrect, xpDelta, hpDeltaLabel, isTimesUp) {
  const verdict = document.getElementById('outcome-verdict');
  const xpBadge = document.getElementById('outcome-xp-delta');
  const hpBadge = document.getElementById('outcome-hp-delta');
  const loRef = document.getElementById('outcome-lo-ref');
  const qText = document.getElementById('outcome-question-text');
  const yourBox = document.getElementById('your-choice-box');
  const yourText = document.getElementById('your-choice-text');
  const rightText = document.getElementById('correct-choice-text');
  const expEl = document.getElementById('dossier-explanation');
  const clueEl = document.getElementById('dossier-board-clue');
  const pathEl = document.getElementById('dossier-pathogenesis');
  const morphEl = document.getElementById('dossier-morphology');
  const txEl = document.getElementById('dossier-epi-tx');
  const ang1El = document.getElementById('dossier-angle-1');
  const ang2El = document.getElementById('dossier-angle-2');
  const ang3El = document.getElementById('dossier-angle-3');
  const contBtn = document.getElementById('continue-runner-btn');
  const backdrop = document.getElementById('outcome-backdrop');
  const scrollBody = document.getElementById('outcome-scroll-body');

  const correctAnswerLabel = (q.shortAnswer && q.shortAnswer.trim())
    ? q.shortAnswer.trim()
    : (q.choices[q.correctIndex] || q.loTitle || 'Correct Answer');

  if (verdict) {
    verdict.textContent = isTimesUp
      ? `⏱ TIME'S UP — ${correctAnswerLabel}`
      : (isCorrect ? `✔ CORRECT — ${correctAnswerLabel}` : `✖ INCORRECT — ${correctAnswerLabel}`);
    verdict.className = `popup-verdict ${isCorrect ? 'is-correct' : 'is-wrong'}`;
  }
  if (xpBadge) {
    xpBadge.textContent = isCorrect
      ? `+${xpDelta} XP (${getComboMultiplier().toFixed(2)}x)`
      : (isTimesUp ? `+0 XP (Time Expired)` : `+0 XP (Streak Reset)`);
  }
  if (hpBadge) hpBadge.textContent = hpDeltaLabel;
  if (loRef) loRef.textContent = `${q.loTitle} • ${q.angle.replace('->', '→')} • ${q.phaseFocus}`;
  if (qText) qText.textContent = q.stem;

  if (yourBox) {
    yourBox.classList.remove('is-right', 'is-wrong');
    yourBox.classList.add(isCorrect ? 'is-right' : 'is-wrong');
  }
  if (yourText) yourText.textContent = isTimesUp ? `⏱ Time's Up (No Selection)` : (q.choices[chosenLane] || '');
  if (rightText) rightText.textContent = q.choices[q.correctIndex] || '';

  const expParts = String(q.explanation || '').split(/\s+Distractor exclusion:\s*/i);
  if (expParts.length > 1) {
    renderDossierBullets(expEl, [expParts[0], `Distractor exclusion: ${expParts[1]}`]);
  } else {
    const expSentences = String(q.explanation || '').split(/(?<=\.)\s+/).filter(Boolean);
    renderDossierBullets(expEl, expSentences.length ? expSentences : [q.explanation]);
  }
  renderDossierBullets(clueEl, [q.secondOrderClue, `Quick Hint: ${q.clue}`]);
  renderDossierBullets(pathEl, [q.phase1Pearl]);
  renderDossierBullets(morphEl, [q.phase2Hallmark]);
  renderDossierBullets(txEl, [q.phase3Secret]);
  renderDossierBullets(ang1El, q.dossierBullets?.p1 || [q.phase1Pearl]);
  renderDossierBullets(ang2El, q.dossierBullets?.p2 || [q.phase2Hallmark]);
  renderDossierBullets(ang3El, q.dossierBullets?.p3 || [q.phase3Secret]);

  if (contBtn) {
    if (playerHp <= 0) contBtn.textContent = `⚠ HP DEPLETED — VIEW SUMMARY`;
    else if (currentIndex + 1 >= activeDeck.length) contBtn.textContent = `🏁 FINISH RUN — VIEW SUMMARY`;
    else contBtn.textContent = `▶ Continue Runner [Space / Enter]`;
  }
  if (scrollBody) scrollBody.scrollTop = 0;
  if (backdrop) backdrop.classList.add('is-open');
  setTimeout(triggerAmbossRescan, 50);
}

function scrollOutcomeBody(deltaY) {
  const body = document.getElementById('outcome-scroll-body');
  if (body) body.scrollBy({ top: deltaY, behavior: 'smooth' });
}

function continueToNextGate() {
  document.getElementById('outcome-backdrop')?.classList.remove('is-open');
  isModalOpen = false;
  if (playerHp <= 0 || currentIndex + 1 >= activeDeck.length) {
    openSummaryModal();
    return;
  }
  currentIndex++;
  prepareNextGate();
}

function skipCurrentQuestion() {
  if (isModalOpen || isRunFinished) return;
  if (timerIntervalId) clearInterval(timerIntervalId);
  playSfx('steer');
  if (currentIndex + 1 >= activeDeck.length) {
    openSummaryModal();
    return;
  }
  currentIndex++;
  prepareNextGate();
}

function openSummaryModal() {
  isRunFinished = true;
  if (timerIntervalId) clearInterval(timerIntervalId);
  const sumTitle = document.getElementById('summary-title');
  const sumSub = document.getElementById('summary-subtitle');
  const sumXp = document.getElementById('sum-xp');
  const sumAcc = document.getElementById('sum-acc');
  const sumStreak = document.getElementById('sum-streak');
  const sumHp = document.getElementById('sum-hp');
  const missedList = document.getElementById('missed-review-list');
  const retryBtn = document.getElementById('retry-missed-btn');
  const backdrop = document.getElementById('summary-backdrop');
  const acc = answeredCount > 0 ? Math.round((correctCount / answeredCount) * 100) : 0;

  if (sumTitle) {
    sumTitle.textContent = playerHp <= 0 ? `BIO-SUIT BREACHED (0 HP)` : `DIAGNOSTIC RUN COMPLETE`;
    sumTitle.className = `popup-verdict ${playerHp <= 0 ? 'is-wrong' : 'is-correct'}`;
  }
  if (sumSub) sumSub.textContent = `Completed ${answeredCount} of ${activeDeck.length} gates (${correctCount} correct) • Best XP: ${bestXp}`;
  if (sumXp) sumXp.textContent = `${playerXp}`;
  if (sumAcc) sumAcc.textContent = `${acc}%`;
  if (sumStreak) sumStreak.textContent = `${bestStreak}`;
  if (sumHp) sumHp.textContent = `${Math.max(0, playerHp)}`;

  if (missedList) {
    if (!missedQuestions.length) {
      missedList.innerHTML = `<div class="missed-empty">✔ FLAWLESS RUN — ZERO MISSED DIAGNOSTIC GATES!</div>`;
      if (retryBtn) retryBtn.style.display = 'none';
    } else {
      missedList.innerHTML = missedQuestions.map((mq) => {
        const correctOpt = mq.choices[mq.correctIndex] || '';
        return `<div class="missed-item"><strong style="color:var(--secondary)">${mq.loTitle}</strong><br>${mq.stem}<br><strong>Correct:</strong> ${correctOpt}<br><span style="color:var(--on-surface-variant)"><strong>Clue:</strong> ${mq.clue}</span></div>`;
      }).join('');
      if (retryBtn) {
        retryBtn.style.display = 'inline-flex';
        retryBtn.textContent = `🎯 Retry Missed Gates (${missedQuestions.length})`;
      }
    }
  }
  if (backdrop) backdrop.classList.add('is-open');
  persistAppState();
}

function closeAllModals() {
  ['outcome-backdrop', 'codex-backdrop', 'summary-backdrop'].forEach((id) => {
    document.getElementById(id)?.classList.remove('is-open');
  });
  isModalOpen = false;
}

// =========================================================================
// CODEX MODAL
// =========================================================================
function openCodex() {
  isModalOpen = true;
  renderCodexTable();
  document.getElementById('codex-backdrop')?.classList.add('is-open');
}

function closeCodex() {
  document.getElementById('codex-backdrop')?.classList.remove('is-open');
  if (!document.getElementById('outcome-backdrop')?.classList.contains('is-open') &&
      !document.getElementById('summary-backdrop')?.classList.contains('is-open')) {
    isModalOpen = false;
  }
}

function setCodexTag(tag) {
  codexTag = tag;
  document.querySelectorAll('.phase-mix-pill[data-codex-tag]').forEach((p) => {
    p.classList.toggle('is-selected', p.dataset.codexTag === tag);
  });
  renderCodexTable();
}

function renderCodexTable() {
  const tbody = document.getElementById('codex-tbody');
  if (!tbody) return;
  const query = (document.getElementById('codex-search')?.value || '').trim().toLowerCase();
  const rows = CODEX_DATA.filter((item) => {
    if (codexTag !== 'all' && item.tag !== codexTag) return false;
    if (!query) return true;
    const blob = `${item.lo} ${item.entity} ${item.etiology} ${item.pathogenesis} ${item.hallmarks} ${item.clinical} ${item.management}`.toLowerCase();
    return blob.includes(query);
  });
  if (!rows.length) {
    tbody.innerHTML = `<tr><td colspan="6">No matching entities found.</td></tr>`;
    return;
  }
  tbody.innerHTML = rows.map((r) => {
    const metaTag = r.badgeMeta ? ` • ${r.badgeMeta}` : '';
    return `<tr>
      <td class="amboss-scan-target"><small style="color:var(--primary);font-family:var(--font-label);">LO ${r.lo}${metaTag}</small><br><strong>${r.entity}</strong></td>
      <td class="amboss-scan-target">${r.etiology}</td>
      <td class="amboss-scan-target">${r.pathogenesis}</td>
      <td class="amboss-scan-target">${r.hallmarks}</td>
      <td class="amboss-scan-target">${r.clinical}</td>
      <td class="amboss-scan-target">${r.management}</td>
    </tr>`;
  }).join('');
}

// =========================================================================
// POINTER, HOVER & KEYBOARD CONTROLS (INCLUDING [H] FOR HINTS)
// =========================================================================
function handleCanvasPointer(evt) {
  if (isModalOpen || isMenuOpen || isRunFinished) return;
  const canvas = document.getElementById('xr-canvas');
  if (!canvas) return;
  const rect = canvas.getBoundingClientRect();
  const cx = evt.clientX - rect.left;
  const cy = evt.clientY - rect.top;
  for (let i = 0; i < portalHitboxes.length; i++) {
    const b = portalHitboxes[i];
    if (cx >= b.x && cx <= b.x + b.w && cy >= b.y && cy <= b.y + b.h) {
      selectLaneAndResolve(b.lane);
      return;
    }
  }
}

function handleCanvasHover(evt) {
  if (isModalOpen || isMenuOpen || isRunFinished) return;
  const canvas = document.getElementById('xr-canvas');
  if (!canvas) return;
  const rect = canvas.getBoundingClientRect();
  const cx = evt.clientX - rect.left;
  const cy = evt.clientY - rect.top;
  for (let i = 0; i < portalHitboxes.length; i++) {
    const b = portalHitboxes[i];
    if (cx >= b.x && cx <= b.x + b.w && cy >= b.y && cy <= b.y + b.h) {
      previewLaneTarget(b.lane);
      return;
    }
  }
}

function handleKeyControls(e) {
  const activeTag = document.activeElement ? document.activeElement.tagName : '';
  if (activeTag === 'INPUT' || activeTag === 'SELECT' || activeTag === 'TEXTAREA') {
    if (e.key === 'Escape') {
      closeCodex();
      if (isMenuOpen) toggleMenuDrawer();
    }
    return;
  }

  const key = e.key.toLowerCase();
  const outcomeOpen = document.getElementById('outcome-backdrop')?.classList.contains('is-open');
  const codexOpen = document.getElementById('codex-backdrop')?.classList.contains('is-open');

  if (e.key === 'Escape') {
    if (codexOpen) { closeCodex(); return; }
    if (isMenuOpen) { toggleMenuDrawer(); return; }
  }

  if (codexOpen) {
    if (key === 'c') { e.preventDefault(); closeCodex(); }
    return;
  }

  if (outcomeOpen) {
    if (key === ' ' || key === 'enter') {
      e.preventDefault();
      continueToNextGate();
    } else if (e.key === 'ArrowDown') {
      e.preventDefault();
      scrollOutcomeBody(140);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      scrollOutcomeBody(-140);
    }
    return;
  }

  if (key === 'm') { e.preventDefault(); toggleMenuDrawer(); return; }
  if (isMenuOpen || isRunFinished) return;

  if (key === 'h') {
    e.preventDefault();
    toggleHintsBar();
  } else if (key === 'c') {
    e.preventDefault();
    openCodex();
  } else if (key === 's') {
    e.preventDefault();
    skipCurrentQuestion();
  } else if (key === 't') {
    e.preventDefault();
    toggleTimerActive();
  } else if (key === '1' || key === 'a' || e.key === 'ArrowLeft') {
    e.preventDefault();
    selectLaneAndResolve(0);
  } else if (key === '2' || key === 'w' || e.key === 'ArrowUp') {
    e.preventDefault();
    selectLaneAndResolve(1);
  } else if (key === '3' || key === 'd' || e.key === 'ArrowRight') {
    e.preventDefault();
    selectLaneAndResolve(2);
  }
}

// =========================================================================
// 3D XR RUNNER CANVAS RENDERER (SYNTHWAVE WIREFRAME VOID + 1:1 PORTAL FUSION)
// =========================================================================
function drawPixelStarfield(ctx, cssW, cssH, vpX, horizonY, theme, dt, warpMult) {
  const spreadX = cssW * 0.58;
  const spreadY = cssH * 0.64;

  ctx.save();
  ctx.fillStyle = theme.particleColor || '#e8cf58';

  for (let i = 0; i < PARALLAX_PARTICLES.length; i++) {
    const p = PARALLAX_PARTICLES[i];
    if (!isModalOpen && !isMenuOpen && !isRunFinished) {
      p.z -= p.speed * dt * warpMult;
      if (p.z <= 0.03) p.z = 1.0;
    }

    const invZ = 1 / (p.z + 0.14);
    const normDepth = 1 - p.z;
    const px = vpX + p.dx * spreadX * (invZ * 0.22);
    const py = horizonY + p.dy * spreadY * (invZ * 0.24);

    if (px < -16 || px > cssW + 16 || py < -16 || py > cssH + 16) continue;

    const sz = Math.min(10.5, Math.max(1.2, p.baseSize * (0.28 + Math.pow(normDepth, 2.2) * 1.9)));
    const alpha = Math.min(0.88, Math.pow(normDepth, 0.7) * 0.85 + 0.08);

    ctx.globalAlpha = alpha;
    ctx.fillRect(Math.round(px - sz * 0.5), Math.round(py - sz * 0.5), sz, sz);
  }
  ctx.restore();
}

function renderRunnerFrame(timestamp) {
  const canvas = document.getElementById('xr-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  if (!ctx) return;

  const dpr = Math.min(window.devicePixelRatio || 1, 2.25);
  const cssW = canvas.clientWidth || 390;
  const cssH = canvas.clientHeight || 360;
  if (canvas.width !== Math.round(cssW * dpr) || canvas.height !== Math.round(cssH * dpr)) {
    canvas.width = Math.round(cssW * dpr);
    canvas.height = Math.round(cssH * dpr);
  }

  const dt = lastFrameTime ? Math.min(0.05, (timestamp - lastFrameTime) / 1000) : 0.016;
  lastFrameTime = timestamp;
  particleTime += dt;

  if (warpSurgeTimer > 0) warpSurgeTimer = Math.max(0, warpSurgeTimer - dt);
  if (portalFlareTimer > 0) portalFlareTimer = Math.max(0, portalFlareTimer - dt);

  const warpFrac = warpSurgeTimer / 0.45;
  const warpSpeedMult = 1 + warpFrac * 4.2;

  if (!isModalOpen && !isMenuOpen && !isRunFinished) {
    if (gateDistance > GAME_CONFIG.stopDistanceMeters) {
      gateDistance = Math.max(GAME_CONFIG.stopDistanceMeters, gateDistance - GAME_CONFIG.gateApproachSpeed * dt);
      trackScrollOffset = (trackScrollOffset + dt * 2.1 * warpSpeedMult) % 1;
    } else {
      trackScrollOffset = (trackScrollOffset + dt * 0.35) % 1;
      if (!isStoppedAtGate) {
        isStoppedAtGate = true;
        for (let i = 0; i < 3; i++) {
          document.getElementById(`lane-${i}-card`)?.classList.add('is-fused');
        }
      }
    }
  }

  craftVisualLane += (currentLane - craftVisualLane) * Math.min(1, dt * 14);

  const q = getCurrentQuestion();
  const theme = getThemeForLo(q.lo);
  const isPortraitCompact = cssW <= 600;
  const horizonY = cssH * (isPortraitCompact ? 0.50 : 0.57);
  const vpX = cssW * 0.5;
  const floorH = cssH - horizonY;

  ctx.save();
  ctx.scale(dpr, dpr);

  // 1. Deep Midnight Void Background
  const bgGrad = ctx.createLinearGradient(0, 0, 0, cssH);
  bgGrad.addColorStop(0, '#070710');
  bgGrad.addColorStop(Math.max(0.1, horizonY / cssH), '#090915');
  bgGrad.addColorStop(1, '#0d0d1c');
  ctx.fillStyle = bgGrad;
  ctx.fillRect(0, 0, cssW, cssH);

  // 2. Infinite Full-Width Synthwave Perspective Floor Wireframe Grid
  const gridRgb = theme.gridRgb || '108, 92, 172';
  ctx.save();
  ctx.beginPath();
  ctx.rect(0, horizonY, cssW, floorH);
  ctx.clip();

  const rowCount = 16;
  ctx.lineWidth = 1;
  for (let i = 0; i < rowCount; i++) {
    const t = (i + trackScrollOffset) / rowCount;
    const persp = Math.pow(t, 2.35);
    const y = horizonY + persp * floorH;
    ctx.strokeStyle = `rgba(${gridRgb}, ${(0.04 + persp * 0.34).toFixed(3)})`;
    ctx.beginPath();
    ctx.moveTo(0, y);
    ctx.lineTo(cssW, y);
    ctx.stroke();
  }

  const colSpan = 22;
  const bottomSpacing = cssW * 0.11;
  for (let c = -colSpan; c <= colSpan; c++) {
    const xBot = vpX + c * bottomSpacing;
    const xTop = vpX + c * (bottomSpacing * 0.045);
    const distFade = Math.max(0.08, 1 - Math.abs(c) / (colSpan + 2));
    const lineGrad = ctx.createLinearGradient(xTop, horizonY, xBot, cssH);
    lineGrad.addColorStop(0, `rgba(${gridRgb}, 0.02)`);
    lineGrad.addColorStop(0.35, `rgba(${gridRgb}, ${(0.18 * distFade).toFixed(3)})`);
    lineGrad.addColorStop(1, `rgba(${gridRgb}, ${(0.34 * distFade).toFixed(3)})`);
    ctx.strokeStyle = lineGrad;
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(xTop, horizonY);
    ctx.lineTo(xBot, cssH);
    ctx.stroke();
  }
  ctx.restore();

  // Soft Horizon Atmospheric Fade
  const fogGrad = ctx.createLinearGradient(0, horizonY - 24, 0, horizonY + 46);
  fogGrad.addColorStop(0, 'rgba(8, 8, 18, 0)');
  fogGrad.addColorStop(0.5, 'rgba(8, 8, 18, 0.85)');
  fogGrad.addColorStop(1, 'rgba(8, 8, 18, 0)');
  ctx.fillStyle = fogGrad;
  ctx.fillRect(0, horizonY - 24, cssW, 70);

  // 3. Crisp 3D Square Pixel-Dust Starfield
  drawPixelStarfield(ctx, cssW, cssH, vpX, horizonY, theme, dt, warpSpeedMult);

  // 4. Three Sleek Teal Perspective Track Beams Running Down the 3 Lanes
  const laneTrackBottomX = isPortraitCompact
    ? [vpX - cssW * 0.44, vpX, vpX + cssW * 0.44]
    : [vpX - cssW * 0.27, vpX, vpX + cssW * 0.27];
  const laneTrackTopX = [vpX - 28, vpX, vpX + 28];

  for (let l = 0; l < 3; l++) {
    const isTargetedLane = l === currentLane;
    const railGrad = ctx.createLinearGradient(laneTrackTopX[l], horizonY, laneTrackBottomX[l], cssH);
    railGrad.addColorStop(0, 'rgba(52, 168, 143, 0.05)');
    railGrad.addColorStop(0.28, isTargetedLane ? '#00ffcc' : 'rgba(52, 168, 143, 0.65)');
    railGrad.addColorStop(1, isTargetedLane ? '#00ffcc' : 'rgba(52, 168, 143, 0.85)');

    ctx.save();
    ctx.fillStyle = railGrad;
    if (isTargetedLane) {
      ctx.shadowColor = '#00ffcc';
      ctx.shadowBlur = 12;
    }
    const topHalf = isTargetedLane ? 1.4 : 0.9;
    const botHalf = isTargetedLane ? 5.5 : 3.6;
    ctx.beginPath();
    ctx.moveTo(laneTrackTopX[l] - topHalf, horizonY);
    ctx.lineTo(laneTrackTopX[l] + topHalf, horizonY);
    ctx.lineTo(laneTrackBottomX[l] + botHalf, cssH);
    ctx.lineTo(laneTrackBottomX[l] - botHalf, cssH);
    ctx.closePath();
    ctx.fill();
    ctx.restore();
  }

  // 5. Three Neon Portal Frames (Pink Left, Cyan Center, Yellow Right) Fusing 1:1 Onto Answer Cards
  const depthProgress = 1 - Math.min(1, Math.max(0, (gateDistance - GAME_CONFIG.stopDistanceMeters) / (GAME_CONFIG.gateStartDistance - GAME_CONFIG.stopDistanceMeters)));
  const easeProgress = Math.pow(depthProgress, 1.35);
  const canvasRect = canvas.getBoundingClientRect();
  portalHitboxes = [];

  for (let laneIdx = 0; laneIdx < 3; laneIdx++) {
    const cardEl = document.getElementById(`lane-${laneIdx}-card`);
    const spreadFrac = laneIdx - 1;
    let targetCx = vpX + spreadFrac * (cssW * 0.31);
    let targetCy = cssH * 0.52;
    let targetW = isPortraitCompact ? (cssW - 16) : Math.min(cssW * 0.29, 350);
    let targetH = isPortraitCompact ? 92 : 148;

    if (cardEl && canvasRect.width > 0) {
      const r = cardEl.getBoundingClientRect();
      if (r.width > 10 && r.height > 10) {
        targetCx = (r.left - canvasRect.left) + r.width * 0.5;
        targetCy = (r.top - canvasRect.top) + r.height * 0.5;
        targetW = r.width;
        targetH = r.height;
      }
    }

    const startCx = vpX + spreadFrac * 26;
    const startCy = horizonY - 4;
    const startW = 24;
    const startH = 20;

    const gx = startCx + (targetCx - startCx) * easeProgress;
    const gy = startCy + (targetCy - startCy) * easeProgress;
    const gw = startW + (targetW - startW) * easeProgress;
    const gh = startH + (targetH - startH) * easeProgress;
    const fusePad = easeProgress * 3;
    const boxX = gx - gw * 0.5 - fusePad;
    const boxY = gy - gh * 0.5 - fusePad;
    const boxW = gw + fusePad * 2;
    const boxH = gh + fusePad * 2;

    portalHitboxes.push({ lane: laneIdx, x: boxX, y: boxY, w: boxW, h: boxH });

    const pColor = LANE_COLORS[laneIdx];
    const isTargeted = laneIdx === currentLane;
    const isFlaring = portalFlareLane === laneIdx && portalFlareTimer > 0;
    const isFusedNow = depthProgress >= 0.98;

    ctx.save();
    ctx.strokeStyle = pColor;
    ctx.fillStyle = pColor;
    ctx.lineWidth = isFlaring ? 6.5 : (isFusedNow ? (isTargeted ? 4.5 : 3.2) : (isTargeted ? 4 : 2.8));
    ctx.shadowColor = pColor;
    ctx.shadowBlur = isFlaring ? 26 : (isFusedNow ? (isTargeted ? 20 : 12) : (isTargeted ? 14 : 7));

    ctx.globalAlpha = isFlaring ? 0.28 : (isTargeted ? 0.14 : 0.06);
    if (typeof ctx.roundRect === 'function') {
      ctx.beginPath();
      ctx.roundRect(boxX, boxY, boxW, boxH, 8);
      ctx.fill();
      ctx.globalAlpha = isTargeted ? 0.98 : (isFusedNow ? 0.82 : 0.72);
      ctx.stroke();
    } else {
      ctx.fillRect(boxX, boxY, boxW, boxH);
      ctx.globalAlpha = isTargeted ? 0.98 : (isFusedNow ? 0.82 : 0.72);
      ctx.strokeRect(boxX, boxY, boxW, boxH);
    }
    ctx.restore();
  }

  // 6. Sleek Geometric Teal Diamond Player Craft Riding the Active Lane Rail
  const craftY = cssH * (isPortraitCompact ? 0.91 : 0.93);
  const craftT = Math.max(0, Math.min(1, (craftY - horizonY) / Math.max(1, floorH)));
  const interpRailTop = vpX + (craftVisualLane - 1) * 28;
  const interpRailBot = vpX + (craftVisualLane - 1) * (isPortraitCompact ? cssW * 0.44 : cssW * 0.27);
  const craftX = interpRailTop + (interpRailBot - interpRailTop) * craftT;
  const hoverBob = Math.sin(particleTime * 4.5) * 2;
  const bankTilt = (currentLane - craftVisualLane) * 0.12;
  const craftHalfW = isPortraitCompact ? 34 : 52;
  const craftHalfH = isPortraitCompact ? 38 : 54;

  ctx.save();
  ctx.translate(craftX, craftY + hoverBob);
  ctx.rotate(bankTilt);
  ctx.shadowColor = '#00e6b8';
  ctx.shadowBlur = 16;

  const craftGrad = ctx.createLinearGradient(0, -craftHalfH, 0, craftHalfH * 0.6);
  craftGrad.addColorStop(0, '#50caa8');
  craftGrad.addColorStop(1, '#268b72');
  ctx.fillStyle = craftGrad;
  ctx.beginPath();
  ctx.moveTo(0, -craftHalfH);
  ctx.lineTo(craftHalfW, 0);
  ctx.lineTo(0, craftHalfH);
  ctx.lineTo(-craftHalfW, 0);
  ctx.closePath();
  ctx.fill();

  ctx.strokeStyle = 'rgba(0, 255, 204, 0.55)';
  ctx.lineWidth = 1.5;
  ctx.stroke();
  ctx.restore();

  ctx.restore();
  animFrameId = requestAnimationFrame(renderRunnerFrame);
}

// =========================================================================
// PERSISTENCE & INITIALIZATION
// =========================================================================
async function persistAppState() {
  if (!window.notebookAppApi || typeof window.notebookAppApi.setAppState !== 'function') return;
  try {
    await window.notebookAppApi.setAppState({
      bestXp,
      bestStreak,
      masteredIds,
      isHintsVisible,
      isSoundEnabled,
      isSfxEnabled,
      isTimerEnabled,
      isTimesUpFailEnabled,
      bgmVolume,
      phaseFilter,
      sectorFilter: document.getElementById('sector-filter')?.value || 'all',
      compartmentFilter: document.getElementById('compartment-filter')?.value || 'all',
      ageFilter: document.getElementById('age-filter')?.value || 'all',
      behaviorFilter: document.getElementById('behavior-filter')?.value || 'all',
      angleFilter: document.getElementById('angle-filter')?.value || 'all'
    });
  } catch (e) {}
}

async function restoreAppState() {
  if (!window.notebookAppApi || typeof window.notebookAppApi.getAppState !== 'function') return;
  try {
    const s = await window.notebookAppApi.getAppState();
    if (!s) return;
    if (typeof s.bestXp === 'number') bestXp = s.bestXp;
    if (typeof s.bestStreak === 'number') bestStreak = s.bestStreak;
    if (Array.isArray(s.masteredIds)) masteredIds = s.masteredIds;
    if (typeof s.isHintsVisible === 'boolean') isHintsVisible = s.isHintsVisible;
    if (typeof s.isSoundEnabled === 'boolean') isSoundEnabled = s.isSoundEnabled;
    if (typeof s.isSfxEnabled === 'boolean') isSfxEnabled = s.isSfxEnabled;
    if (typeof s.isTimerEnabled === 'boolean') isTimerEnabled = s.isTimerEnabled;
    if (typeof s.isTimesUpFailEnabled === 'boolean') isTimesUpFailEnabled = s.isTimesUpFailEnabled;
    if (typeof s.bgmVolume === 'number') {
      bgmVolume = s.bgmVolume;
      const slider = document.getElementById('bgm-volume-slider');
      if (slider) slider.value = String(Math.round(bgmVolume * 100));
    }
    if (s.phaseFilter) {
      phaseFilter = s.phaseFilter;
      document.querySelectorAll('.phase-mix-pill[data-phase]').forEach((p) => {
        p.classList.toggle('is-selected', p.dataset.phase === phaseFilter);
      });
    }
    const setVal = (id, v) => { const el = document.getElementById(id); if (el && v) el.value = v; };
    setVal('sector-filter', s.sectorFilter);
    setVal('compartment-filter', s.compartmentFilter);
    setVal('age-filter', s.ageFilter);
    setVal('behavior-filter', s.behaviorFilter);
    setVal('angle-filter', s.angleFilter);
  } catch (e) {}
}

async function initRunnerGame() {
  initDynamicSelectors();
  await restoreAppState();
  syncHintsUI();
  syncMissedOptionLabel();
  buildDeck(false);
  updateTelemetryUI();
  prepareNextGate();

  const canvas = document.getElementById('xr-canvas');
  if (canvas) {
    canvas.addEventListener('click', handleCanvasPointer);
    canvas.addEventListener('mousemove', handleCanvasHover);
    canvas.addEventListener('pointermove', handleCanvasHover);
  }
  window.addEventListener('keydown', handleKeyControls);

  if (animFrameId) cancelAnimationFrame(animFrameId);
  animFrameId = requestAnimationFrame(renderRunnerFrame);

  if (window.notebookAppApi && typeof window.notebookAppApi.notifyAppReady === 'function') {
    window.notebookAppApi.notifyAppReady();
  }
}

if (document.readyState === 'loading') {
  window.addEventListener('DOMContentLoaded', initRunnerGame);
} else {
  initRunnerGame();
}
</script>
