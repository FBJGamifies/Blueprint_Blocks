<!--
  XR 3-LANE DIAGNOSTIC RUNNER — RESPIRATORY PHARMACOLOGY, BUGS & VIRUSES EDITION (v3.8 INTERACTIVE)
  Strictly aligned with Step 1 & Step 2 v3.81 Blueprint Specifications:
  - 4-band minimalist cockpit (#xr-app.hints-hidden / .hints-visible) with flex layout & proportional auto-resize.
  - Ultra-slim top bar with small ☰ MENU button + compact read-only telemetry chips only (HP 100, XP, Streak, Gate, 50s Timer).
  - Top question stage with 3-second auto-fading metadata badges (LO, Angle, Phase, Corridor) and center-aligned stem.
  - Center 3D synthwave void with 150 crisp 3D square pixel-dust particles, wireframe floor, 3 teal perspective rails,
    teal diamond craft, and Pink/Cyan/Yellow portals fusing 1:1 onto the 3 centered answer cards (with runtime choice shuffling).
  - Complete #top-menu-drawer, 7-Part Centered Bulleted Outcome Dossier Modal, 6-Column Master Raid Loot Codex Modal,
    End-of-Run Performance Summary Modal, and Kino der Toten–inspired Web Audio SFX + Procedural BGM engine.
-->
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="artifact-type" content="tool">
<meta name="design-style" content="neon_noir">
<title>Respiratory Pharmacology, Bugs &amp; Viruses XR 3-Lane Diagnostic Runner (v3.8)</title>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=Inter:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
:root {
  color-scheme: dark;
  /* Neon Noir Surface & Accent Tokens */
  --background: #0a0a12;
  --surface-container-low: #111118;
  --surface-container: #141422;
  --surface-container-high: #1e1e30;
  --surface-overlay: rgba(10, 10, 18, 0.92);
  --surface-glass: rgba(16, 16, 28, 0.96);
  --surface-stem: rgba(24, 12, 26, 0.86);
  --surface-lane-card: rgba(16, 16, 30, 0.88);
  --surface-lane-card-hover: rgba(24, 20, 42, 0.94);

  --on-surface: #e8e0f0;
  --on-surface-bright: #ffffff;
  --on-surface-variant: #a098b0;
  --outline: #5a5068;
  --outline-variant: #302840;

  --primary: #ff2d78;
  --on-primary: #1a0010;
  --secondary: #00ffcc;
  --on-secondary: #001a14;
  --tertiary: #ffe04a;
  --on-tertiary: #1a1500;
  --data-4: #b388ff;
  --positive: #00e6a8;
  --warning: #ffe04a;
  --error: #ff4444;
  --focus: #00ffcc;

  /* Typography */
  --font-headline: 'Sora', sans-serif;
  --font-body: 'Inter', sans-serif;
  --font-label: 'Space Mono', monospace;

  /* Responsive Scales (Tablet & Desktop Default) */
  --game-headline-size: clamp(1.15rem, 1rem + 0.45vw, 1.48rem);
  --game-stem-size: clamp(1.04rem, 0.98rem + 0.28vw, 1.24rem);
  --game-body-size: clamp(0.98rem, 0.94rem + 0.16vw, 1.08rem);
  --game-label-size: 0.78rem;
  --game-micro-size: 0.68rem;

  /* Dynamic Answer Card Sizing (Larger when Hints Hidden, Proportionally Compact when Hints Visible) */
  --card-min-h: 158px;
  --card-pad-y: 1.25rem;
  --card-pad-x: 1.2rem;
  --card-font: clamp(1.06rem, 1.0rem + 0.24vw, 1.24rem);
  --card-gap: 1rem;
  --stem-pad-y: 0.62rem;
  --stem-pad-x: 1.1rem;

  /* 1.0x Normal Scale for Modals */
  --modal-display-size: clamp(1.25rem, 1.1rem + 0.7vw, 1.75rem);
  --modal-headline-size: clamp(1rem, 0.94rem + 0.3vw, 1.22rem);
  --modal-body-size: clamp(0.875rem, 0.85rem + 0.12vw, 0.96rem);
  --modal-label-size: 0.72rem;

  /* Spacing & Radii */
  --space-xs: 0.25rem;
  --space-sm: 0.45rem;
  --space-md: 0.85rem;
  --space-lg: 1.25rem;
  --rounded: 0.18rem;
  --rounded-lg: 0.38rem;

  /* Motion */
  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  --dur-micro: 120ms;
  --dur-short: 220ms;

  /* Glows & Borders */
  --glow-text: 0 0 8px currentColor;
  --glow-primary: 0 0 18px color-mix(in srgb, var(--primary) 48%, transparent);
  --glow-secondary: 0 0 18px color-mix(in srgb, var(--secondary) 44%, transparent);
  --glow-tertiary: 0 0 18px color-mix(in srgb, var(--tertiary) 46%, transparent);
  --neon-border: 1px solid color-mix(in srgb, var(--primary) 32%, transparent);
  --neon-border-lit: 1px solid color-mix(in srgb, var(--primary) 58%, transparent);
  --neon-border-cyan: 1px solid color-mix(in srgb, var(--secondary) 42%, transparent);
  --neon-inset: inset 0 0 12px color-mix(in srgb, var(--primary) 10%, transparent);
  --neon-inset-cyan: inset 0 0 12px color-mix(in srgb, var(--secondary) 10%, transparent);
  --scanlines: repeating-linear-gradient(to bottom, transparent 0 3px, color-mix(in srgb, var(--on-surface) 2.5%, transparent) 3px 4px);
  --vignette-damage: radial-gradient(circle at center, transparent 45%, color-mix(in srgb, var(--error) 65%, transparent) 100%);
  --vignette-heal: radial-gradient(circle at center, transparent 45%, color-mix(in srgb, var(--positive) 55%, transparent) 100%);
}

*, *::before, *::after { box-sizing: border-box; }

html, body {
  margin: 0;
  padding: 0;
  width: 100%;
  height: 100dvh;
  overflow: hidden;
  background-color: var(--background);
  color: var(--on-surface);
  font-family: var(--font-body);
  font-size: var(--game-body-size);
  line-height: 1.45;
  -webkit-text-size-adjust: 100%;
}

button, input, select {
  font-family: inherit;
  color: inherit;
}

:focus-visible {
  outline: 2px solid var(--focus);
  outline-offset: 2px;
}

/* Main Full-Viewport 4-Band Cockpit */
#xr-app {
  position: relative;
  width: 100%;
  height: 100dvh;
  display: flex;
  flex-direction: column;
  background-color: var(--background);
  background-image: var(--scanlines);
  overflow: hidden;
}

/* Proportional Resize State: When Hints Are Displayed at Bottom */
#xr-app.hints-visible {
  --card-min-h: 90px;
  --card-pad-y: 0.6rem;
  --card-pad-x: 0.9rem;
  --card-font: clamp(0.94rem, 0.9rem + 0.16vw, 1.06rem);
  --card-gap: 0.7rem;
  --stem-pad-y: 0.4rem;
  --stem-pad-x: 0.95rem;
  --game-stem-size: clamp(0.95rem, 0.91rem + 0.2vw, 1.1rem);
}

/* =========================================================
   BAND 1: ULTRA-SLIM TOP UTILITY BAR (SMALL MENU BUTTON ONLY)
   ========================================================= */
.top-mini-bar {
  flex-shrink: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  padding: 0.28rem 0.65rem;
  background: var(--surface-container-low);
  border-bottom: 1px solid var(--outline-variant);
}

.menu-mini-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.35rem;
  min-height: 32px;
  padding: 0.22rem 0.65rem;
  background: var(--surface-container);
  color: var(--secondary);
  border: var(--neon-border-cyan);
  border-radius: var(--rounded);
  font-family: var(--font-label);
  font-size: 0.76rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  cursor: pointer;
  touch-action: manipulation;
  transition: box-shadow var(--dur-short) var(--ease-out), border-color var(--dur-short) var(--ease-out), background-color var(--dur-short) var(--ease-out);
}
.menu-mini-btn:hover,
.menu-mini-btn.is-active {
  border-color: var(--secondary);
  background: var(--surface-container-high);
  box-shadow: var(--glow-secondary);
  text-shadow: var(--glow-text);
}

.mini-telemetry {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  gap: 0.45rem;
  overflow-x: auto;
  scrollbar-width: none;
  font-family: var(--font-label);
  font-size: 0.72rem;
  font-weight: 700;
  color: var(--on-surface-variant);
}
.mini-telemetry::-webkit-scrollbar { display: none; }

.tele-chip {
  display: inline-flex;
  align-items: center;
  gap: 0.24rem;
  white-space: nowrap;
  padding: 0.14rem 0.42rem;
  border-radius: var(--rounded);
  background: var(--surface-container);
  border: 1px solid var(--outline-variant);
}
.tele-chip.is-hp { color: var(--positive); border-color: color-mix(in srgb, var(--positive) 40%, transparent); }
.tele-chip.is-hp.is-low { color: var(--error); border-color: var(--error); }
.tele-chip.is-xp { color: var(--secondary); }
.tele-chip.is-streak { color: var(--tertiary); }
.tele-chip.is-timer { color: var(--secondary); border-color: color-mix(in srgb, var(--secondary) 40%, transparent); }
.tele-chip.is-timer.is-off { color: var(--on-surface-variant); border-color: var(--outline-variant); }
.tele-chip.is-timer.is-hold { color: var(--tertiary); border-color: var(--tertiary); }
.tele-chip.is-timer.is-urgent { color: var(--error); border-color: var(--error); }

/* =========================================================
   BAND 2: QUESTION STAGE AT THE TOP (WITH 3s AUTO-FADE BADGES)
   ========================================================= */
.question-stage {
  flex-shrink: 0;
  z-index: 12;
  background: linear-gradient(180deg, rgba(17, 17, 24, 0.96) 0%, rgba(10, 10, 18, 0.84) 100%);
  border-bottom: 1px solid var(--outline-variant);
  padding: 0.4rem 0.85rem 0.48rem;
  text-align: center;
  transition: padding var(--dur-short) var(--ease-out);
}

#xr-app.hints-visible .question-stage {
  padding: 0.28rem 0.75rem 0.34rem;
}

.question-container {
  max-width: 1080px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

/* Metadata Row (LO, Angle, Phase, Corridor) — Auto-Hides Smoothly After 3 Seconds */
.question-meta-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 0.3rem;
  max-height: 92px;
  opacity: 1;
  margin-bottom: 0.34rem;
  overflow: hidden;
  transition: opacity 400ms var(--ease-out), max-height 400ms var(--ease-out), margin-bottom 400ms var(--ease-out);
}

.question-meta-row.is-faded {
  opacity: 0;
  max-height: 0;
  margin-bottom: 0;
  pointer-events: none;
}

.meta-badge {
  font-family: var(--font-label);
  font-size: 0.62rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  line-height: 1.2;
  text-transform: uppercase;
  padding: 0.14rem 0.46rem;
  border-radius: var(--rounded);
  border: 1px solid var(--outline);
  background: var(--surface-container);
  color: var(--secondary);
}
.meta-badge.is-angle {
  border-color: color-mix(in srgb, var(--primary) 54%, transparent);
  color: var(--primary);
}
.meta-badge.is-phase {
  border-color: color-mix(in srgb, var(--tertiary) 54%, transparent);
  color: var(--tertiary);
}
.meta-badge.is-corridor {
  border-color: color-mix(in srgb, var(--data-4) 55%, transparent);
  color: var(--data-4);
}

.question-stem-box {
  width: 100%;
  max-width: 1020px;
  margin: 0 auto;
  background: var(--surface-stem);
  border: var(--neon-border-lit);
  box-shadow: var(--neon-inset);
  border-radius: var(--rounded-lg);
  padding: var(--stem-pad-y) var(--stem-pad-x);
  max-height: 30dvh;
  overflow-y: auto;
  text-align: center;
  transition: padding var(--dur-short) var(--ease-out);
}

#xr-app.hints-visible .question-stem-box {
  max-height: 23dvh;
}

.question-stem {
  margin: 0 auto;
  font-family: var(--font-body);
  font-size: var(--game-stem-size);
  font-weight: 600;
  color: var(--on-surface-bright);
  text-align: center;
  line-height: 1.4;
  transition: font-size var(--dur-short) var(--ease-out);
}

/* =========================================================
   BAND 3: CENTER INTERACTIVE 3D XR VIEWPORT + COLOR-CODED CARDS
   ========================================================= */
.viewport-shell {
  position: relative;
  flex: 1 1 0;
  min-height: 0;
  width: 100%;
  background: var(--background);
  overflow: hidden;
}

#xr-canvas {
  display: block;
  width: 100%;
  height: 100%;
  cursor: pointer;
}

.lane-overlay-container {
  position: absolute;
  top: 52%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: min(1120px, calc(100% - 1.5rem));
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--card-gap);
  z-index: 10;
  pointer-events: none;
  transition: gap var(--dur-short) var(--ease-out);
}

.lane-dom-card {
  --lane-color: var(--secondary);
  pointer-events: auto;
  position: relative;
  background: rgba(14, 17, 27, 0.76);
  backdrop-filter: blur(8px);
  border: 1px solid color-mix(in srgb, var(--secondary) 38%, transparent);
  border-radius: 0.45rem;
  padding: var(--card-pad-y) var(--card-pad-x);
  min-height: var(--card-min-h);
  text-align: center;
  cursor: pointer;
  font-family: var(--font-body);
  font-size: var(--card-font);
  font-weight: 700;
  color: var(--on-surface-bright);
  box-shadow: 0 8px 26px rgba(0, 0, 0, 0.55),
              inset 0 0 12px rgba(0, 255, 204, 0.05);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  gap: 0.55rem;
  line-height: 1.35;
  touch-action: manipulation;
  transition: min-height var(--dur-short) var(--ease-out),
              padding var(--dur-short) var(--ease-out),
              font-size var(--dur-short) var(--ease-out),
              transform var(--dur-micro) var(--ease-out),
              border-color var(--dur-short) var(--ease-out),
              box-shadow var(--dur-short) var(--ease-out),
              background-color var(--dur-short) var(--ease-out);
}

/* Color-Coded Portal Lanes: Pink (Left), Cyan (Center), Yellow (Right) */
.lane-dom-card.lane-0 { --lane-color: var(--primary); }
.lane-dom-card.lane-1 { --lane-color: var(--secondary); }
.lane-dom-card.lane-2 { --lane-color: var(--tertiary); }

.lane-dom-card:hover,
.lane-dom-card.is-targeted {
  border-color: color-mix(in srgb, var(--lane-color) 85%, transparent);
  background: rgba(18, 22, 36, 0.92);
  box-shadow: 0 0 22px color-mix(in srgb, var(--lane-color) 32%, transparent),
              inset 0 0 14px color-mix(in srgb, var(--lane-color) 10%, transparent);
  transform: translateY(-2px);
}

.lane-dom-card.is-fused {
  border-color: color-mix(in srgb, var(--lane-color) 78%, transparent);
  box-shadow: 0 0 18px color-mix(in srgb, var(--lane-color) 28%, transparent),
              inset 0 0 12px color-mix(in srgb, var(--lane-color) 10%, transparent);
}

.lane-dom-card.is-fused.is-targeted {
  border-color: var(--lane-color);
  box-shadow: 0 0 26px color-mix(in srgb, var(--lane-color) 42%, transparent),
              inset 0 0 16px color-mix(in srgb, var(--lane-color) 14%, transparent);
}

.lane-dom-card.is-selected {
  background: color-mix(in srgb, var(--lane-color) 20%, rgba(14, 17, 27, 0.96));
  border-color: var(--lane-color);
  box-shadow: 0 0 30px color-mix(in srgb, var(--lane-color) 65%, transparent);
  transform: scale(1.015);
}

.lane-card-head {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.4rem;
}

.lane-portal-name {
  font-family: var(--font-label);
  font-size: 0.64rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--secondary);
  opacity: 0.88;
}

.lane-key-label {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-label);
  font-size: 0.62rem;
  font-weight: 700;
  color: var(--primary);
  letter-spacing: 0.06em;
  padding: 0.12rem 0.45rem;
  border-radius: 0.22rem;
  border: 1px solid color-mix(in srgb, var(--primary) 55%, transparent);
  background: rgba(255, 45, 120, 0.08);
}

.lane-choice-body {
  flex: 1 1 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  text-align: center;
}

.fusion-lock-tag {
  font-family: var(--font-label);
  font-size: 0.58rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--on-surface-variant);
  text-align: center;
  opacity: 0;
  max-height: 0;
  overflow: hidden;
  transition: opacity 220ms var(--ease-out), max-height 220ms var(--ease-out);
}

.lane-dom-card.is-fused .fusion-lock-tag {
  opacity: 0.72;
  max-height: 20px;
}

.vignette-overlay {
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: 0;
  z-index: 12;
  transition: opacity var(--dur-short) var(--ease-out);
}
.vignette-overlay.is-damage { background: var(--vignette-damage); opacity: 1; }
.vignette-overlay.is-heal { background: var(--vignette-heal); opacity: 1; }

.heal-toast {
  position: absolute;
  top: 0.6rem;
  left: 50%;
  transform: translateX(-50%);
  background: var(--surface-glass);
  border: 1px solid var(--positive);
  color: var(--positive);
  font-family: var(--font-label);
  font-size: 0.78rem;
  font-weight: 700;
  text-transform: uppercase;
  padding: 0.25rem 0.7rem;
  border-radius: var(--rounded);
  opacity: 0;
  pointer-events: none;
  transition: opacity var(--dur-short) var(--ease-out);
  z-index: 15;
}
.heal-toast.is-visible { opacity: 1; }

/* =========================================================
   BAND 4: BOTTOM HINTS BAR (TOGGLED BY [H] OR MENU)
   ========================================================= */
#hints-bar {
  flex-shrink: 0;
  z-index: 15;
  background: var(--surface-container);
  border-top: 2px solid color-mix(in srgb, var(--tertiary) 55%, transparent);
  box-shadow: 0 -6px 20px rgba(0, 0, 0, 0.45);
  padding: 0.48rem 0.85rem;
  max-height: 22dvh;
  overflow-y: auto;
  text-align: center;
}

#xr-app.hints-hidden #hints-bar {
  display: none;
}

.hints-inner {
  max-width: 1080px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.2rem;
  text-align: center;
}

.hints-header-row {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 0.4rem;
}

.hints-tag {
  font-family: var(--font-label);
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--tertiary);
}

.hints-subtag {
  font-family: var(--font-label);
  font-size: 0.64rem;
  color: var(--secondary);
  opacity: 0.9;
}

.hints-text {
  margin: 0 auto;
  font-size: clamp(0.88rem, 0.84rem + 0.16vw, 0.98rem);
  color: var(--on-surface);
  text-align: center;
  line-height: 1.4;
}

/* =========================================================
   FULL MENU & SKILL TREE DRAWER (TITLE + ALL BUTTONS LIVE HERE)
   ========================================================= */
.menu-backdrop {
  position: fixed;
  inset: 0;
  z-index: 80;
  background: var(--surface-overlay);
  display: none;
  align-items: flex-start;
  justify-content: center;
  padding: 0.75rem;
  overflow-y: auto;
}
.menu-backdrop.is-open { display: flex; }

#top-menu-drawer {
  width: min(1040px, 100%);
  max-height: calc(100dvh - 1.5rem);
  overflow-y: auto;
  background: var(--surface-glass);
  backdrop-filter: blur(14px);
  border: 1px solid var(--secondary);
  box-shadow: var(--glow-secondary);
  border-radius: var(--rounded-lg);
  padding: 1rem 1.15rem 1.25rem;
  display: flex;
  flex-direction: column;
  gap: 0.85rem;
  text-align: center;
}

.menu-top-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 0.75rem;
  text-align: left;
  padding-bottom: 0.65rem;
  border-bottom: 1px solid var(--outline-variant);
}

.menu-title-stack {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  min-width: 0;
}

.brand-kicker {
  display: inline-block;
  align-self: flex-start;
  font-family: var(--font-label);
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.09em;
  text-transform: uppercase;
  color: var(--secondary);
  text-shadow: var(--glow-text);
}

.brand-title {
  margin: 0;
  font-family: var(--font-headline);
  font-size: var(--game-headline-size);
  font-weight: 800;
  letter-spacing: -0.02em;
  line-height: 1.2;
  color: var(--on-surface-bright);
}

.menu-section-label {
  font-family: var(--font-label);
  font-size: 0.7rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--secondary);
  text-align: left;
  margin-bottom: 0.35rem;
}

.btn-neon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.35rem;
  background: var(--surface-container);
  color: var(--primary);
  border: var(--neon-border-lit);
  border-radius: var(--rounded);
  padding: 0.42rem 0.8rem;
  min-height: 40px;
  font-family: var(--font-label);
  font-size: 0.76rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  cursor: pointer;
  touch-action: manipulation;
  transition: box-shadow var(--dur-short) var(--ease-out),
              border-color var(--dur-short) var(--ease-out),
              background-color var(--dur-short) var(--ease-out);
}
.btn-neon:hover:not(:disabled) {
  border-color: var(--primary);
  box-shadow: var(--glow-primary);
  background: var(--surface-container-high);
  text-shadow: var(--glow-text);
}
.btn-neon:disabled { opacity: 0.45; cursor: not-allowed; }
.btn-neon.is-cyan { color: var(--secondary); border-color: color-mix(in srgb, var(--secondary) 48%, transparent); }
.btn-neon.is-cyan:hover:not(:disabled) { border-color: var(--secondary); box-shadow: var(--glow-secondary); }
.btn-neon.is-yellow { color: var(--tertiary); border-color: color-mix(in srgb, var(--tertiary) 48%, transparent); }
.btn-neon.is-yellow:hover:not(:disabled) { border-color: var(--tertiary); box-shadow: var(--glow-tertiary); }
.btn-neon.is-purple { color: var(--data-4); border-color: color-mix(in srgb, var(--data-4) 52%, transparent); }
.btn-neon.is-purple:hover:not(:disabled) { border-color: var(--data-4); box-shadow: 0 0 14px color-mix(in srgb, var(--data-4) 40%, transparent); }
.btn-neon.is-active { background: var(--surface-container-high); box-shadow: var(--glow-secondary); }

.menu-actions-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(165px, 1fr));
  gap: 0.45rem;
}

.controls-strip {
  display: flex;
  flex-wrap: wrap;
  align-items: end;
  justify-content: flex-start;
  gap: 0.65rem;
}

.control-field {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 0.25rem;
  flex: 1 1 200px;
}

.control-field label {
  font-family: var(--font-label);
  font-size: 0.68rem;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--on-surface-variant);
}

.neon-select {
  width: 100%;
  background: var(--surface-container-low);
  color: var(--on-surface);
  border: 1px solid var(--outline);
  border-bottom: 2px solid var(--secondary);
  border-radius: var(--rounded);
  padding: 0.35rem 0.6rem;
  font-family: var(--font-label);
  font-size: 0.75rem;
  min-height: 40px;
  cursor: pointer;
}

.volume-row {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  width: 100%;
  min-height: 40px;
}
.volume-slider {
  flex: 1 1 auto;
  accent-color: var(--secondary);
  cursor: pointer;
}

.phase-mix-strip {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
}

.phase-mix-pill {
  font-family: var(--font-label);
  font-size: 0.72rem;
  padding: 0.35rem 0.65rem;
  min-height: 36px;
  border-radius: var(--rounded);
  border: 1px solid var(--outline);
  background: var(--surface-container-low);
  color: var(--on-surface);
  cursor: pointer;
  touch-action: manipulation;
}
.phase-mix-pill.is-selected {
  border-color: var(--primary);
  color: var(--primary);
  box-shadow: var(--glow-primary);
}

.menu-divider {
  width: 100%;
  border: 0;
  border-top: 1px solid var(--outline-variant);
  margin: 0.1rem 0;
}

.skill-tree-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr));
  gap: 0.45rem;
}

.skill-node {
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
  padding: 0.55rem 0.65rem;
  background: var(--surface-container-low);
  border: 1px solid var(--outline-variant);
  border-radius: var(--rounded);
  text-align: left;
  cursor: pointer;
  touch-action: manipulation;
}
.skill-node:hover { border-color: var(--secondary); box-shadow: var(--glow-secondary); }
.skill-node.is-mastered { border-color: var(--positive); }
.skill-node.is-active-filter { border-color: var(--primary); background: var(--surface-container-high); }

.skill-node-top {
  display: flex;
  justify-content: space-between;
  font-family: var(--font-label);
  font-size: 0.66rem;
  color: var(--secondary);
}
.skill-node-title {
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--on-surface);
  line-height: 1.3;
}
.skill-node-meta {
  font-family: var(--font-label);
  font-size: 0.64rem;
  color: var(--on-surface-variant);
}

.hotkey-guide {
  font-family: var(--font-label);
  font-size: 0.7rem;
  color: var(--on-surface-variant);
  background: var(--surface-container-low);
  border: 1px solid var(--outline-variant);
  border-radius: var(--rounded);
  padding: 0.45rem 0.65rem;
  line-height: 1.5;
  text-align: center;
}

.inline-toast {
  font-family: var(--font-label);
  font-size: 0.74rem;
  color: var(--tertiary);
  text-align: left;
  min-height: 1.1em;
}

/* =========================================================
   MODALS (OUTCOME DOSSIER — STRICTLY CENTERED, CODEX, SUMMARY)
   ========================================================= */
.modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 100;
  background: var(--surface-overlay);
  display: none;
  align-items: center;
  justify-content: center;
  padding: var(--space-md);
}
.modal-backdrop.is-open { display: flex; }

#outcome-popup-modal {
  width: 80vw;
  height: 80vh;
  max-width: 1120px;
  background: var(--surface-container);
  border: var(--neon-border-lit);
  box-shadow: var(--glow-primary);
  border-radius: var(--rounded-lg);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  text-align: center;
  font-size: var(--modal-body-size);
}

.popup-header {
  flex-shrink: 0;
  background: var(--surface-container-high);
  border-bottom: 1px solid var(--outline-variant);
  padding: 0.55rem 0.85rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
}
.popup-header-centered {
  justify-content: center;
  flex-wrap: wrap;
  text-align: center;
}
.popup-verdict {
  margin: 0;
  font-family: var(--font-headline);
  font-size: var(--modal-headline-size);
  font-weight: 800;
  text-align: center;
}
.popup-verdict.is-correct { color: var(--positive); }
.popup-verdict.is-wrong { color: var(--error); }
.popup-verdict.is-cyan { color: var(--secondary); }

.popup-question-pin {
  flex-shrink: 0;
  background: var(--surface-container-low);
  border-bottom: 1px solid var(--outline-variant);
  padding: 0.45rem 0.85rem;
  max-height: 18vh;
  overflow-y: auto;
  text-align: center;
}
.popup-question-pin-label {
  display: block;
  font-family: var(--font-label);
  font-size: 0.64rem;
  text-transform: uppercase;
  color: var(--secondary);
  margin-bottom: 2px;
  text-align: center;
}
.popup-question-pin-text {
  margin: 0 auto;
  font-size: 0.86rem;
  font-weight: 600;
  color: var(--on-surface);
  text-align: center;
  line-height: 1.45;
}

.popup-scroll-body {
  flex: 1 1 auto;
  overflow-y: auto;
  padding: 0.85rem;
  display: flex;
  flex-direction: column;
  gap: 0.55rem;
  text-align: center;
}

.dossier-block {
  background: var(--surface-container-low);
  border: 1px solid var(--outline-variant);
  border-radius: var(--rounded-lg);
  padding: 0.65rem 0.85rem;
  text-align: center;
}
.dossier-block.is-highlight {
  border-color: color-mix(in srgb, var(--secondary) 45%, transparent);
  box-shadow: var(--neon-inset-cyan);
}
.dossier-block-title {
  margin: 0 0 0.25rem 0;
  font-family: var(--font-label);
  font-size: var(--modal-label-size);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--secondary);
  text-align: center;
}
.dossier-block p,
.dossier-line {
  margin: 0 auto;
  font-size: 0.88rem;
  color: var(--on-surface);
  text-align: center;
  line-height: 1.5;
}
.dossier-line + .dossier-line { margin-top: 0.25rem; }

.choice-compare-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0.5rem;
}
.choice-box {
  background: var(--surface-container);
  border: 1px solid var(--outline);
  border-radius: var(--rounded);
  padding: 0.5rem;
  text-align: center;
}
.choice-box p {
  margin: 0 auto;
  text-align: center;
}
.choice-box.is-right { border-color: var(--positive); }
.choice-box.is-wrong { border-color: var(--error); }
.choice-box-tag {
  display: block;
  font-family: var(--font-label);
  font-size: 0.64rem;
  text-transform: uppercase;
  color: var(--on-surface-variant);
  margin-bottom: 2px;
  text-align: center;
}

.angle-dossier-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0.5rem;
}
.angle-mini-card {
  background: var(--surface-container);
  border: 1px solid var(--outline-variant);
  border-radius: var(--rounded);
  padding: 0.65rem 0.55rem;
  text-align: center;
}
.angle-mini-card strong {
  display: block;
  font-family: var(--font-label);
  font-size: 0.68rem;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--primary);
  margin-bottom: 6px;
  text-align: center;
}

.popup-footer {
  flex-shrink: 0;
  background: var(--surface-container-high);
  border-top: 1px solid var(--outline-variant);
  padding: 0.5rem 0.85rem;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 0.5rem;
}

/* Codex Modal */
#codex-modal {
  width: min(94vw, 1340px);
  height: 85vh;
  background: var(--surface-container);
  border: var(--neon-border-cyan);
  box-shadow: var(--glow-secondary);
  border-radius: var(--rounded-lg);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  text-align: center;
  font-size: var(--modal-body-size);
}
.codex-controls {
  flex-shrink: 0;
  background: var(--surface-container-low);
  border-bottom: 1px solid var(--outline-variant);
  padding: 0.6rem 0.85rem;
  display: flex;
  flex-wrap: wrap;
  align-items: end;
  justify-content: center;
  gap: 0.55rem;
}
.codex-search-input {
  width: 100%;
  background: var(--surface-container);
  color: var(--on-surface);
  border: 1px solid var(--outline);
  border-bottom: 2px solid var(--secondary);
  border-radius: var(--rounded);
  padding: 0.35rem 0.7rem;
  min-width: 220px;
  min-height: 38px;
  font-size: var(--modal-body-size);
}
.codex-table-wrap {
  flex: 1 1 auto;
  overflow: auto;
  -webkit-overflow-scrolling: touch;
  padding: 0.55rem 0.85rem;
}
.codex-table {
  width: 100%;
  min-width: 820px;
  border-collapse: collapse;
  font-size: 0.86rem;
  text-align: left;
}
.codex-table th {
  position: sticky;
  top: 0;
  background: var(--surface-container-high);
  color: var(--secondary);
  font-family: var(--font-label);
  font-size: var(--modal-label-size);
  text-transform: uppercase;
  padding: 0.55rem;
  border-bottom: 2px solid var(--outline);
}
.codex-table td {
  padding: 0.55rem;
  border-bottom: 1px solid var(--outline-variant);
  vertical-align: top;
  line-height: 1.45;
}
.codex-table tbody tr:nth-child(even) { background: var(--surface-container-low); }

/* Summary Modal */
#run-summary-modal {
  width: min(92vw, 840px);
  max-height: 86vh;
  background: var(--surface-container);
  border: var(--neon-border-lit);
  box-shadow: var(--glow-primary);
  border-radius: var(--rounded-lg);
  padding: 1.15rem;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 0.65rem;
  overflow: hidden;
  font-size: var(--modal-body-size);
}
.summary-subtitle { margin: 0; color: var(--on-surface-variant); text-align: center; }
.summary-metrics {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 0.5rem;
}
.summary-tile {
  background: var(--surface-container-low);
  border: 1px solid var(--outline);
  border-radius: var(--rounded);
  padding: 0.55rem;
  text-align: center;
}
.summary-tile-val {
  display: block;
  font-family: var(--font-headline);
  font-size: var(--modal-display-size);
  font-weight: 800;
  color: var(--secondary);
}
.summary-tile-label {
  font-family: var(--font-label);
  font-size: var(--modal-label-size);
  text-transform: uppercase;
  color: var(--on-surface-variant);
}
.missed-review-list {
  flex: 1 1 auto;
  overflow-y: auto;
  background: var(--surface-container-low);
  border: 1px solid var(--outline-variant);
  border-radius: var(--rounded);
  padding: 0.55rem;
  text-align: left;
  min-height: 110px;
}
.missed-item {
  background: var(--surface-container);
  border-left: 3px solid var(--error);
  padding: 0.4rem 0.6rem;
  border-radius: var(--rounded);
  font-size: 0.86rem;
  margin-bottom: 0.4rem;
  line-height: 1.45;
}
.missed-empty {
  color: var(--positive);
  font-family: var(--font-label);
  font-size: var(--modal-label-size);
  text-align: center;
  padding: 1rem;
}

.shake-anim { animation: viewport-shake 300ms var(--ease-out); }
@keyframes viewport-shake {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-7px); }
  40% { transform: translateX(7px); }
  60% { transform: translateX(-4px); }
  80% { transform: translateX(4px); }
}

/* =========================================================
   PORTRAIT PHONE OPTIMIZATION (<= 600px) — TABLETS 100% UNTOUCHED
   ========================================================= */
@media (max-width: 600px) {
  :root {
    --game-stem-size: 0.96rem;
    --card-min-h: 96px;
    --card-pad-y: 0.78rem;
    --card-pad-x: 0.9rem;
    --card-font: 0.97rem;
    --card-gap: 0.65rem;
    --stem-pad-y: 0.48rem;
    --stem-pad-x: 0.75rem;
  }

  #xr-app.hints-visible {
    --game-stem-size: 0.88rem;
    --card-min-h: 60px;
    --card-pad-y: 0.44rem;
    --card-pad-x: 0.75rem;
    --card-font: 0.88rem;
    --card-gap: 0.42rem;
    --stem-pad-y: 0.34rem;
    --stem-pad-x: 0.65rem;
  }

  .top-mini-bar { padding: 0.24rem 0.45rem; }
  .menu-mini-btn { min-height: 34px; padding: 0.2rem 0.55rem; font-size: 0.72rem; }
  .mini-telemetry { gap: 0.3rem; font-size: 0.68rem; }
  .tele-chip.is-xp { display: none; }

  .question-stage { padding: 0.34rem 0.5rem 0.4rem; }
  .question-stem-box { max-height: 30dvh; }
  #xr-app.hints-visible .question-stem-box { max-height: 22dvh; }

  .lane-overlay-container {
    top: 44%;
    width: calc(100% - 1rem);
    grid-template-columns: 1fr;
  }
  .lane-card-head, .lane-key-label { display: none; }

  #hints-bar { padding: 0.4rem 0.65rem; max-height: 22dvh; }
  .hints-text { font-size: 0.84rem; line-height: 1.35; }

  .menu-backdrop { padding: 0.35rem; }
  #top-menu-drawer { max-height: calc(100dvh - 0.7rem); padding: 0.8rem; }
  .menu-actions-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }

  .choice-compare-grid,
  .angle-dossier-grid { grid-template-columns: 1fr; }
  .summary-metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); }

  .modal-backdrop { padding: 0.35rem; }
  #outcome-popup-modal,
  #codex-modal,
  #run-summary-modal {
    width: 96vw;
    height: 92dvh;
    max-height: 92dvh;
  }
  .popup-question-pin { max-height: 20dvh; }
  .codex-table { min-width: 680px; font-size: 0.8rem; }
}

/* =========================================================
   LANDSCAPE PHONE OPTIMIZATION (<= 500px TALL TOUCH SCREENS)
   NEVER FIRES ON TABLETS (>= 744px TALL) OR DESKTOPS
   ========================================================= */
@media (max-height: 500px) and (pointer: coarse) {
  :root {
    --game-stem-size: 0.88rem;
    --card-min-h: 82px;
    --card-pad-y: 0.5rem;
    --card-pad-x: 0.68rem;
    --card-font: 0.86rem;
    --card-gap: 0.55rem;
    --stem-pad-y: 0.3rem;
    --stem-pad-x: 0.7rem;
  }

  #xr-app.hints-visible {
    --game-stem-size: 0.82rem;
    --card-min-h: 54px;
    --card-pad-y: 0.32rem;
    --card-pad-x: 0.55rem;
    --card-font: 0.8rem;
    --card-gap: 0.45rem;
    --stem-pad-y: 0.24rem;
    --stem-pad-x: 0.6rem;
  }

  .top-mini-bar { padding: 0.16rem 0.5rem; }
  .menu-mini-btn { min-height: 28px; padding: 0.14rem 0.5rem; font-size: 0.68rem; }
  .question-stage { padding: 0.2rem 0.55rem; }
  .question-stem-box { max-height: 25dvh; }
  #xr-app.hints-visible .question-stem-box { max-height: 20dvh; }
  .lane-overlay-container {
    top: 46%;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    width: calc(100% - 1rem);
  }
  .lane-card-head, .lane-key-label { display: none; }
  #hints-bar { padding: 0.26rem 0.6rem; max-height: 20dvh; }
  .hints-text { font-size: 0.78rem; line-height: 1.3; }
  #outcome-popup-modal,
  #codex-modal,
  #run-summary-modal {
    width: 96vw;
    height: 94dvh;
    max-height: 94dvh;
  }
}

/* =========================================================
   DESKTOP-MODE SAFETY NET FOR TALL PHONES (ASPECT <= 9/16)
   NEVER FIRES ON TABLETS (PORTRAIT ~10/16 OR LANDSCAPE 16/10)
   ========================================================= */
@media (min-width: 601px) and (max-aspect-ratio: 9/16) and (pointer: coarse) {
  html { font-size: 200%; }
  .lane-overlay-container {
    top: 44%;
    width: calc(100% - 1rem);
    grid-template-columns: 1fr;
  }
  .lane-card-head, .lane-key-label { display: none; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}
</style>
</head>
<body>
<div id="xr-app" class="hints-hidden">

  <!-- BAND 1: ULTRA-SLIM TOP BAR (SMALL MENU BUTTON + COMPACT READOUTS ONLY) -->
  <div class="top-mini-bar">
    <button type="button" class="menu-mini-btn" id="menu-toggle-btn" onclick="toggleMenuDrawer()" aria-expanded="false" aria-controls="top-menu-drawer">☰ MENU</button>
    <div class="mini-telemetry" aria-label="Game Status">
      <span class="tele-chip is-hp" id="hp-chip">HP <span id="hp-text">100</span></span>
      <span class="tele-chip is-xp">XP <span id="xp-text">0</span></span>
      <span class="tele-chip is-streak">⚡<span id="streak-text">0</span></span>
      <span class="tele-chip"><span id="progress-text">1/45</span></span>
      <span class="tele-chip is-timer is-off" id="timer-chip">⏱ OFF</span>
    </div>
  </div>

  <!-- BAND 2: QUESTION DISPLAYED AT THE TOP (METADATA + CORRIDOR BADGE AUTO-HIDE AFTER 3 SECONDS) -->
  <div class="question-stage">
    <div class="question-container">
      <div class="question-meta-row" id="question-meta-row">
        <span class="meta-badge" id="lo-badge">LO 1</span>
        <span class="meta-badge is-angle" id="angle-badge">PRESENTATION → DIAGNOSIS</span>
        <span class="meta-badge is-phase" id="phase-badge">PHASE 1: PATHOGENESIS</span>
        <span class="meta-badge is-corridor" id="corridor-badge">CORRIDOR</span>
      </div>
      <div class="question-stem-box">
        <p class="question-stem amboss-scan-target" id="q-stem-text">Loading diagnostic corridor…</p>
      </div>
    </div>
  </div>

  <!-- BAND 3: CENTER INTERACTIVE 3D XR VIEWPORT + 3 COLOR-CODED CENTERED ANSWER CARDS -->
  <div class="viewport-shell" id="viewport-shell">
    <canvas id="xr-canvas" aria-label="3D Perspective Diagnostic Corridor"></canvas>
    <div class="lane-overlay-container" id="lane-overlay-container">
      <div id="lane-0-card" class="lane-dom-card lane-0" role="button" tabindex="0"
        onmouseenter="previewLaneTarget(0)" onpointerenter="previewLaneTarget(0)" onfocus="previewLaneTarget(0)"
        onclick="selectLaneAndResolve(0)"
        onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();selectLaneAndResolve(0);}">
        <div class="lane-card-head">
          <span class="lane-portal-name">LEFT PORTAL</span>
          <span class="lane-key-label">1 / A / ←</span>
        </div>
        <div class="lane-choice-body">
          <span id="lane-0-text" class="amboss-scan-target">Option A</span>
        </div>
        <span class="fusion-lock-tag">5M FUSION LOCK</span>
      </div>
      <div id="lane-1-card" class="lane-dom-card lane-1 is-targeted" role="button" tabindex="0"
