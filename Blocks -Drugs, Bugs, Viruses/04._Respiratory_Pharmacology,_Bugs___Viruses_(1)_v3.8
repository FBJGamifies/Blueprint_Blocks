  document.querySelectorAll('.phase-mix-pill[data-phase]').forEach((p) => {
    p.classList.toggle('is-selected', p.dataset.phase === val);
  });
  applyFilters();
}

function buildDeck(randomize, customSource) {
  const secVal = document.getElementById('sector-filter')?.value || 'all';
  const compVal = document.getElementById('compartment-filter')?.value || 'all';
  const ageVal = document.getElementById('age-filter')?.value || 'all';
  const behVal = document.getElementById('behavior-filter')?.value || 'all';
  const angVal = document.getElementById('angle-filter')?.value || 'all';
  const msgEl = document.getElementById('menu-status-msg');
  let pool;

  if (Array.isArray(customSource) && customSource.length > 0) {
    pool = customSource.slice();
  } else if (secVal === 'missed') {
    pool = missedQuestions.filter((q) => {
      const matchComp = compVal === 'all' || q.compartment === compVal;
      const matchAge = ageVal === 'all' || q.ageGroup === ageVal || q.ageGroup === 'all';
      const matchBeh = behVal === 'all' || q.behavior === behVal;
      const matchAng = angVal === 'all' || q.angle === angVal;
      const matchPha = phaseFilter === 'all' || q.phaseFocus === phaseFilter;
      return matchComp && matchAge && matchBeh && matchAng && matchPha;
    });
  } else {
    pool = ALL_QUESTIONS.filter((q) => {
      const matchLo = secVal === 'all' || String(q.lo) === String(secVal) || q.sector === secVal;
      const matchComp = compVal === 'all' || q.compartment === compVal;
      const matchAge = ageVal === 'all' || q.ageGroup === ageVal || q.ageGroup === 'all';
      const matchBeh = behVal === 'all' || q.behavior === behVal;
      const matchAng = angVal === 'all' || q.angle === angVal;
      const matchPha = phaseFilter === 'all' || q.phaseFocus === phaseFilter;
      return matchLo && matchComp && matchAge && matchBeh && matchAng && matchPha;
    });
  }

  if (!pool.length) {
    pool = ALL_QUESTIONS.slice();
    if (msgEl) {
      msgEl.textContent = secVal === 'missed'
        ? `No missed gates yet — loaded all ${ALL_QUESTIONS.length} gates.`
        : `No gates matched that filter combo — restored all ${ALL_QUESTIONS.length} gates.`;
    }
  } else if (msgEl) {
    msgEl.textContent = `Active Queue: ${pool.length} gates ready.`;
  }

  const ordered = randomize ? fisherYatesShuffle(pool) : pool.slice();
  activeDeck = ordered.map(shuffleQuestionOptions);
}

function getCurrentQuestion() {
  if (!activeDeck.length) buildDeck(false);
  return activeDeck[currentIndex] || activeDeck[0];
}

