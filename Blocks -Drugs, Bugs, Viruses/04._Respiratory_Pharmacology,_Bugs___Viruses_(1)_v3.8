function buildSkillTree() {
  const grid = document.getElementById('skill-tree-grid');
  if (!grid) return;
  const secVal = document.getElementById('sector-filter')?.value || 'all';
  let masteredLos = 0;
  grid.innerHTML = CODEX_DATA.map((c) => {
    const loQs = ALL_QUESTIONS.filter((q) => q.lo === c.lo);
    const done = loQs.filter((q) => masteredIds.includes(q.id)).length;
    const isMastered = done === loQs.length && loQs.length > 0;
    if (isMastered) masteredLos++;
    const isActive = String(secVal) === String(c.lo);
    const metaTag = c.badgeMeta ? ` • ${c.badgeMeta}` : '';
    return `<button type="button" class="skill-node ${isMastered ? 'is-mastered' : ''} ${isActive ? 'is-active-filter' : ''}" onclick="selectSectorFromTree(${c.lo})">
      <div class="skill-node-top"><span>LO ${c.lo}${metaTag}</span><span>${done}/${loQs.length}</span></div>
      <div class="skill-node-title">${c.entity}</div>
      <div class="skill-node-meta">${isMastered ? '✔ MASTERED' : 'TAP TO DEPLOY'}</div>
    </button>`;
  }).join('');
  const sumEl = document.getElementById('mastery-summary');
  const acc = answeredCount > 0 ? `${Math.round((correctCount / answeredCount) * 100)}%` : '--%';
  if (sumEl) sumEl.textContent = `Mastered: ${masteredLos} / ${CODEX_DATA.length} LOs • Accuracy: ${acc}`;
}

function selectSectorFromTree(loNum) {
  const sel = document.getElementById('sector-filter');
  if (sel) sel.value = String(loNum);
  applyFilters();
  if (isMenuOpen) toggleMenuDrawer();
}

function setPhaseFilter(val) {
