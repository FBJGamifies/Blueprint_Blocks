function syncTimerControlsUI() {
  const modeSel = document.getElementById('times-up-select');
  const menuTimerBtn = document.getElementById('menu-timer-btn');
  const chip = document.getElementById('timer-chip');
  if (modeSel) modeSel.value = isTimesUpFailEnabled ? 'fail' : 'hold';
  if (menuTimerBtn) {
    menuTimerBtn.textContent = isTimerEnabled ? `⏱ 50s Timer: ON [T]` : `⏱ 50s Timer: OFF [T]`;
    menuTimerBtn.classList.toggle('is-active', isTimerEnabled);
  }
  if (!chip) return;
  chip.classList.remove('is-off', 'is-hold', 'is-urgent');
  if (!isTimerEnabled) {
    chip.textContent = `⏱ OFF`;
    chip.classList.add('is-off');
  } else if (timeRemaining === 0 && !isTimesUpFailEnabled) {
    chip.textContent = `⏱ HOLD`;
    chip.classList.add('is-hold');
  } else {
    chip.textContent = `⏱ ${timeRemaining}s`;
    if (timeRemaining <= 10) chip.classList.add('is-urgent');
  }
}

function applyTimerSettings() {
  const modeSel = document.getElementById('times-up-select');
  if (modeSel) isTimesUpFailEnabled = modeSel.value === 'fail';
  syncTimerControlsUI();
  persistAppState();
}

function toggleTimerActive() {
  if (isRunFinished) return;
  isTimerEnabled = !isTimerEnabled;
  if (isTimerEnabled) {
    startQuestionTimer();
    playSfx('steer');
  } else {
    if (timerIntervalId) clearInterval(timerIntervalId);
    syncTimerControlsUI();
  }
  persistAppState();
}

function startTimedSession() {
  isTimerEnabled = true;
  isTimesUpFailEnabled = true;
  if (isMenuOpen) toggleMenuDrawer();
  syncTimerControlsUI();
  startQuestionTimer();
  playSfx('warp');
  persistAppState();
}

function startQuestionTimer() {
  if (timerIntervalId) clearInterval(timerIntervalId);
  timeRemaining = GAME_CONFIG.timerSeconds;
  syncTimerControlsUI();
  if (!isTimerEnabled) return;
  timerIntervalId = setInterval(() => {
    if (isModalOpen || isMenuOpen || isRunFinished || !isTimerEnabled) return;
    if (timeRemaining > 0) {
      timeRemaining--;
      syncTimerControlsUI();
      if (timeRemaining === 0) {
        if (isTimesUpFailEnabled) {
          clearInterval(timerIntervalId);
          resolveGateChoice(-1);
        } else {
          syncTimerControlsUI();
        }
      }
    }
  }, 1000);
}

function updateTelemetryUI() {
  const hpText = document.getElementById('hp-text');
  const hpChip = document.getElementById('hp-chip');
  const xpText = document.getElementById('xp-text');
  const streakText = document.getElementById('streak-text');
  const progText = document.getElementById('progress-text');
  const clampedHp = Math.max(0, playerHp);
  if (hpText) hpText.textContent = `${clampedHp}`;
  if (hpChip) hpChip.classList.toggle('is-low', clampedHp <= 30);
  if (xpText) xpText.textContent = `${playerXp}`;
  if (streakText) streakText.textContent = `${streak}`;
  if (progText) progText.textContent = `${Math.min(currentIndex + 1, activeDeck.length)}/${activeDeck.length}`;
  syncTimerControlsUI();
  syncSoundControlsUI();
  syncHintsUI();
}

function triggerAmbossRescan() {
  const stage = document.querySelector('.question-stage');
  if (stage) stage.setAttribute('data-amboss-timestamp', String(Date.now()));
}

function scheduleMetadataAutoHide() {
  const metaRow = document.getElementById('question-meta-row');
  if (!metaRow) return;
  if (metaFadeTimeoutId) {
    clearTimeout(metaFadeTimeoutId);
    metaFadeTimeoutId = null;
  }
  metaRow.classList.remove('is-faded');
  metaFadeTimeoutId = setTimeout(() => {
    metaRow.classList.add('is-faded');
  }, GAME_CONFIG.metaFadeMs);
}

function updateLaneHighlight() {
  for (let i = 0; i < 3; i++) {
    const card = document.getElementById(`lane-${i}-card`);
    if (card) {
      card.classList.toggle('is-targeted', i === currentLane);
      card.classList.toggle('is-selected', hasChosenLane && i === currentLane);
    }
  }
}

function previewLaneTarget(laneIndex) {
  if (isModalOpen || isMenuOpen || isRunFinished) return;
  if (laneIndex < 0 || laneIndex > 2) return;
  if (currentLane !== laneIndex) {
    currentLane = laneIndex;
    updateLaneHighlight();
    const now = performance.now();
    if (now - lastSteerSfxTime > 95) {
      lastSteerSfxTime = now;
      playSfx('steer');
    }
  }
}

function updateQuestionStageUI() {
  const q = getCurrentQuestion();
  const theme = getThemeForLo(q.lo);
  const loBadge = document.getElementById('lo-badge');
  const angleBadge = document.getElementById('angle-badge');
  const phaseBadge = document.getElementById('phase-badge');
  const corridorBadge = document.getElementById('corridor-badge');
  const stemEl = document.getElementById('q-stem-text');
  const clueEl = document.getElementById('q-clue-text');
  const hintRefEl = document.getElementById('hints-meta-ref');

  if (loBadge) loBadge.textContent = q.loTitle;
  if (angleBadge) angleBadge.textContent = q.angle.replace('->', '→');
  if (phaseBadge) phaseBadge.textContent = q.phaseFocus;
  if (corridorBadge) corridorBadge.textContent = `CORRIDOR: ${theme.tag}`;
  if (stemEl) stemEl.textContent = q.stem;
  if (clueEl) clueEl.textContent = q.clue;
  if (hintRefEl) hintRefEl.textContent = `${q.loTitle} • ${q.phaseFocus}`;

  for (let i = 0; i < 3; i++) {
    const txt = document.getElementById(`lane-${i}-text`);
    if (txt) txt.textContent = q.choices[i] || '';
  }

  updateLaneHighlight();
  scheduleMetadataAutoHide();
  triggerAmbossRescan();
}

