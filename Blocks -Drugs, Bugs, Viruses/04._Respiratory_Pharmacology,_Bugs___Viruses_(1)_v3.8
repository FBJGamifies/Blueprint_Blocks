  if (sfxBtn) sfxBtn.textContent = (isSoundEnabled && isSfxEnabled) ? `🔊 SFX: ON` : `🔇 SFX: OFF`;
  const bgmActive = isSoundEnabled && isBgmPlaying;
  if (menuBgmBtn) {
    menuBgmBtn.textContent = bgmActive
      ? (customBgmUrl ? `🎵 Custom BGM: ON (${customBgmName})` : `🎵 Zombies BGM: ON`)
      : (customBgmUrl ? `🎵 Custom BGM: OFF` : `🎵 Zombies BGM: OFF`);
  }
  if (volLabel) volLabel.textContent = `${Math.round(bgmVolume * 100)}%`;
}

function toggleMasterSound() {
  isSoundEnabled = !isSoundEnabled;
  const customAudio = document.getElementById('custom-bgm-audio');
  if (!isSoundEnabled) {
    stopProceduralZombiesBgm();
    if (customAudio) customAudio.pause();
  } else if (isBgmPlaying) {
    if (customBgmUrl && customAudio) {
      stopProceduralZombiesBgm();
      customAudio.volume = bgmVolume;
      customAudio.play().catch(() => {});
    } else {
      startProceduralZombiesBgm();
    }
  }
  syncSoundControlsUI();
  persistAppState();
}

function toggleSfx() {
  isSfxEnabled = !isSfxEnabled;
  if (isSfxEnabled && !isSoundEnabled) isSoundEnabled = true;
  syncSoundControlsUI();
  persistAppState();
}

function toggleBgm() {
  const customAudio = document.getElementById('custom-bgm-audio');
  isBgmPlaying = !isBgmPlaying;
  if (isBgmPlaying) {
    if (!isSoundEnabled) isSoundEnabled = true;
    if (customBgmUrl && customAudio) {
      stopProceduralZombiesBgm();
      customAudio.volume = bgmVolume;
      customAudio.play().catch(() => {});
    } else {
      startProceduralZombiesBgm();
    }
  } else {
    stopProceduralZombiesBgm();
    if (customAudio) customAudio.pause();
  }
  syncSoundControlsUI();
  persistAppState();
}

function updateBgmVolume(val) {
  bgmVolume = Math.max(0, Math.min(1, Number(val) / 100));
  const customAudio = document.getElementById('custom-bgm-audio');
  if (customAudio) customAudio.volume = bgmVolume;
  if (bgmNodes.masterGain && audioCtx) {
    bgmNodes.masterGain.gain.setTargetAtTime(bgmVolume * 0.45, audioCtx.currentTime, 0.05);
  }
  syncSoundControlsUI();
  persistAppState();
}

function handleCustomBgmUpload(evt) {
  const file = evt.target && evt.target.files ? evt.target.files[0] : null;
  if (!file) return;
  if (customBgmUrl) URL.revokeObjectURL(customBgmUrl);
  customBgmUrl = URL.createObjectURL(file);
  customBgmName = file.name.length > 16 ? file.name.slice(0, 13) + '…' : file.name;
  isSoundEnabled = true;
  isBgmPlaying = true;
  const customAudio = document.getElementById('custom-bgm-audio');
  stopProceduralZombiesBgm();
  if (customAudio) {
    customAudio.src = customBgmUrl;
    customAudio.volume = bgmVolume;
    customAudio.play().catch(() => {});
  }
  syncSoundControlsUI();
  persistAppState();
}

