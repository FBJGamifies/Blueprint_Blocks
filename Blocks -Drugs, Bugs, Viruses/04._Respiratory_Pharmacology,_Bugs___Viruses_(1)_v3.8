function fisherYatesShuffle(arr) {
  const copy = arr.slice();
  for (let i = copy.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    const tmp = copy[i];
    copy[i] = copy[j];
    copy[j] = tmp;
  }
  return copy;
}

function shuffleQuestionOptions(q) {
  const indexed = q.choices.map((text, idx) => ({ text, isCorrect: idx === q.correctIndex }));
  const shuffled = fisherYatesShuffle(indexed);
  return {
    ...q,
    choices: shuffled.map((item) => item.text),
    correctIndex: shuffled.findIndex((item) => item.isCorrect)
  };
}

function getComboMultiplier() {
  return Math.min(3.0, 1.0 + streak * 0.25);
}

